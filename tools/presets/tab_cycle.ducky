REM 📑 Multi-Tab Workspace Launcher
REM Title: 📑 Multi-Tab Launcher
REM Description: Opens multiple web workspaces in parallel tabs.
REM Tags: workspace, tabs, productivity
REM Variables: TAB_1, TAB_2, TAB_3

VAR TAB_1=https://x.com
VAR TAB_2=https://google.com
VAR TAB_3=https://github.com

LOG Opening Tab 1: $TAB_1
NAVIGATE $TAB_1
RANDOM_DELAY 1200 2000

LOG Opening Tab 2: $TAB_2
CTRL+T $TAB_2
RANDOM_DELAY 1200 2000

LOG Opening Tab 3: $TAB_3
CTRL+T $TAB_3
RANDOM_DELAY 1200 2000
LOG Multi-Tab workspace initialized
