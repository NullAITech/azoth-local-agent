# API Keys (Optional if running local Ollama)
# Prefer XAI_API_KEY for xAI Grok; fall back to OPENAI_API_KEY for OpenAI/Ollama
XAI_API_KEY=
OPENAI_API_KEY=

# Ollama default: http://localhost:11434/v1
# xAI Grok:        https://api.x.ai/v1
OPENAI_BASE_URL=http://localhost:11434/v1

# Models: qwen2.5-coder:1.5b, llama3, grok-2-latest, gemma4:12b
MODEL=qwen2.5-coder:1.5b
