FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm-256color

# Install fundamental OS utilities, development tools, and networking
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    curl \
    wget \
    git \
    python3 \
    python3-pip \
    python3-venv \
    procps \
    net-tools \
    iproute2 \
    iputils-ping \
    dnsutils \
    htop \
    tree \
    nano \
    vim-tiny \
    sudo \
    ca-certificates \
    jq \
    tar \
    unzip \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create azoth agent user with passwordless sudo
RUN useradd -m -s /bin/bash -u 1000 azoth && \
    echo "azoth ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/azoth && \
    chmod 0440 /etc/sudoers.d/azoth

# Create workspace directory
RUN mkdir -p /workspace && chown azoth:azoth /workspace

# Setup custom bash prompt and welcome banner
RUN echo 'export PS1="\[\033[01;36m\]⚡ azoth@guest-os\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ "' >> /home/azoth/.bashrc && \
    echo 'export PS1="\[\033[01;31m\]root@guest-os\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]# "' >> /root/.bashrc && \
    echo 'cat << "BANNER"' >> /home/azoth/.bashrc && \
    echo '   ___               _   _      ____  ____  ' >> /home/azoth/.bashrc && \
    echo '  / _ \___  ___ _ __| |_| |__  / __ \/ ___| ' >> /home/azoth/.bashrc && \
    echo ' / /_\ /_ \/ _ \  __| __|  _ \| |  | \___ \ ' >> /home/azoth/.bashrc && \
    echo '/ /_\\ / // (_) | |  | |_| | | | |__| |___) |' >> /home/azoth/.bashrc && \
    echo '\____/___/\___/_|   \__|_| |_|\____/|____/ ' >> /home/azoth/.bashrc && \
    echo '  ⚡ aZoth Autonomous Linux Guest OS v1.0   ' >> /home/azoth/.bashrc && \
    echo '  Isolated Virtual Environment for Agents   ' >> /home/azoth/.bashrc && \
    echo 'BANNER' >> /home/azoth/.bashrc

WORKDIR /workspace
USER azoth

CMD ["/bin/bash", "-c", "while true; do sleep 3600; done"]
